<form class="modern-card" style="max-width: 400px; width: 100%;">
    <h2 style="color: #0f3460; margin-bottom: 20px;">Meu Primeiro Formulário</h2>
    
    <label for="nome" style="display: block; margin-bottom: 8px; font-weight: 600; color: #555;">Nome:</label>
    <input type="text" id="nome" class="nomeInput" style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 6px; margin-bottom: 20px;" />
    
    <button style="width: 100%; padding: 12px; background-color: #e94560; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; transition: background 0.3s;">
        Salvar Dados
    </button>
</form>
