<div style="width: 140px; height: 300px; background-color: #ba885a; border: 2px solid #643f25; position: relative; border-radius: 2px;">
    <span style="position: absolute; top: 2px; left: 2px; background-color: rgba(0,0,0,0.5); color: white; font-size: 10px; padding: 2px 4px; border-radius: 3px; font-family: monospace; z-index: 10;">
        &lt;Door /&gt;
    </span>
    <Hinge Top="true" Side="@Side" />
    <Hinge Top="false" Side="@Side" />
    <div style="@GetHandleStyle()" title="Handle"></div>
</div>

@code {
    [Parameter]
    public string Side { get; set; } = "left";

    private string GetHandleStyle()
    {
        var isLeft = Side == "left";
        var horizontalPosition = isLeft ? "right: 10px;" : "left: 10px;";
        
        return $@"
            width: 10px;
            height: 40px;
            background-color: #3b3a36;
            border-radius: 5px;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            {horizontalPosition}
        ";
    }
}
